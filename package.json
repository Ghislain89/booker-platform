{
  "name": "booker-platform",
  "version": "1.0.0",
  "description": "Booker Platform: a local hotel booking app (web UI + REST API) used as test object for Playwright trainings",
  "main": "dist/server.js",
  "scripts": {
    "setup": "prisma migrate reset --force",
    "dev": "ts-node-dev --respawn --transpile-only --ignore-watch web server/server.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "ts-node --transpile-only server/server.ts --static",
    "test": "playwright test",
    "lint": "eslint playwright",
    "typecheck": "tsc && tsc -p web",
    "prisma:seed": "ts-node prisma/seed.ts",
    "prisma:reset": "npx prisma migrate reset --force",
    "codegen": "orval --config orval.config.ts",
    "swagger:export": "ts-node scripts/export-swagger.ts",
    "postinstall": "node -e \"const fs=require('fs');if(!fs.existsSync('.env')&&fs.existsSync('.env.example'))fs.copyFileSync('.env.example','.env')\""
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "keywords": [],
  "author": "Ghislain Gabriëlse",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.10.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.64.0",
    "@tanstack/react-query": "^5.104.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.11.24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^8.57.0",
    "eslint-plugin-playwright": "^1.8.3",
    "jest": "^30.5.2",
    "npm-run-all": "^4.1.5",
    "orval": "^8.41.0",
    "prettier": "3.9.9",
    "prisma": "^5.10.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4",
    "swagger-cli": "^4.0.4",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^7.0.2",
    "vite": "^6.4.4",
    "zod": "^3.24.2"
  },
  "overrides": {
    "@asyncapi/generator": "3.3.0",
    "@asyncapi/generator-helpers": "1.1.0",
    "@asyncapi/generator-components": "0.7.0",
    "@asyncapi/specs": "6.11.1"
  },
  "private": true
}
