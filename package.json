{
  "name": "booker-platform",
  "version": "1.0.0",
  "description": "Booker Platform: a local hotel booking app (web UI + REST API) used as test object for Playwright trainings",
  "main": "dist/server.js",
  "scripts": {
    "setup": "prisma generate && prisma migrate reset --force && prisma db seed",
    "dev": "node --watch --watch-preserve-output --import tsx server/server.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "tsx server/server.ts --static",
    "test": "playwright test",
    "lint": "eslint playwright",
    "typecheck": "tsc && tsc -p web",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:reset": "prisma migrate reset --force && prisma db seed",
    "codegen": "orval --config orval.config.ts",
    "swagger:export": "tsx scripts/export-swagger.ts",
    "postinstall": "node -e \"const fs=require('fs');if(!fs.existsSync('.env')&&fs.existsSync('.env.example'))fs.copyFileSync('.env.example','.env')\" && prisma generate"
  },
  "keywords": [],
  "author": "Ghislain Gabriëlse",
  "license": "MIT",
  "dependencies": {
    "@prisma/adapter-libsql": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^4.22.3",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.64.0",
    "@tanstack/react-query": "^5.104.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.11.24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.13.0",
    "eslint-plugin-playwright": "^2.12.1",
    "orval": "^8.41.0",
    "prettier": "3.9.10",
    "prisma": "^7.10.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.4.4",
    "zod": "^4.6.7"
  },
  "overrides": {
    "@asyncapi/generator": "3.3.0",
    "@asyncapi/generator-helpers": "1.1.0",
    "@asyncapi/generator-components": "0.7.0",
    "@asyncapi/specs": "6.11.1",
    "swagger-jsdoc": {
      "glob": "^13.0.6"
    }
  },
  "private": true
}
